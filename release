#!/usr/bin/env bash
set -euo pipefail

# ---- Project configuration -----------------------------------------------
APP_NAME="ics205"
VERSION_FILE="version.txt"
TEST_COMMAND=(./mill __.test)
BUILD_COMMAND=(./mill web.assembly)
ARTIFACT="out/web/assembly.dest/out.jar"
# -------------------------------------------------------------------------

die() { echo "ERROR: $*" >&2; exit 1; }

cleanup_artifacts() {
  [[ -n "${RELEASE_ARTIFACT:-}" ]] && rm -f -- "$RELEASE_ARTIFACT"
  [[ -n "${CHECKSUM_FILE:-}" ]] && rm -f -- "$CHECKSUM_FILE"
}

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

[[ -f "$VERSION_FILE" ]] || die "Cannot find version file: $VERSION_FILE"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not in a Git repository."
command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) is not installed."
gh auth status >/dev/null 2>&1 || die "GitHub CLI is not authenticated. Run: gh auth login"
git remote get-url origin >/dev/null 2>&1 || die "Git remote 'origin' is not configured."
[[ -z "$(git status --porcelain)" ]] || die "Git working tree is not clean."

CURRENT_VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
if [[ ! "$CURRENT_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)-SNAPSHOT$ ]]; then
  die "$VERSION_FILE must contain X.Y.Z-SNAPSHOT; found '$CURRENT_VERSION'."
fi

MAJOR="${BASH_REMATCH[1]}"
MINOR="${BASH_REMATCH[2]}"
PATCH="${BASH_REMATCH[3]}"
DEFAULT_RELEASE="${MAJOR}.${MINOR}.${PATCH}"
DEFAULT_NEXT="${MAJOR}.${MINOR}.$((PATCH + 1))-SNAPSHOT"

read -r -p "Release version [$DEFAULT_RELEASE]: " RELEASE_VERSION
RELEASE_VERSION="${RELEASE_VERSION:-$DEFAULT_RELEASE}"
[[ "$RELEASE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Release version must be X.Y.Z."

read -r -p "Next version [$DEFAULT_NEXT]: " NEXT_VERSION
NEXT_VERSION="${NEXT_VERSION:-$DEFAULT_NEXT}"
[[ "$NEXT_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$ ]] || die "Next version must be X.Y.Z-SNAPSHOT."

TAG="v${RELEASE_VERSION}"
case "$ARTIFACT" in
  *.*) ARTIFACT_EXTENSION=".${ARTIFACT##*.}" ;;
  *)   ARTIFACT_EXTENSION="" ;;
esac
RELEASE_ARTIFACT="${APP_NAME}-${RELEASE_VERSION}${ARTIFACT_EXTENSION}"
CHECKSUM_FILE="${RELEASE_ARTIFACT}.sha256"

git show-ref --verify --quiet "refs/tags/$TAG" && die "Local tag $TAG already exists."
if git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null 2>&1; then
  die "Remote tag $TAG already exists."
fi
if gh release view "$TAG" >/dev/null 2>&1; then
  die "GitHub Release $TAG already exists."
fi

echo
echo "Current version : $CURRENT_VERSION"
echo "Release version : $RELEASE_VERSION"
echo "Next version    : $NEXT_VERSION"
echo "Tag             : $TAG"
echo "Artifact        : $RELEASE_ARTIFACT"
printf 'Test command     :'; printf ' %q' "${TEST_COMMAND[@]}"; printf '\n'
printf 'Build command    :'; printf ' %q' "${BUILD_COMMAND[@]}"; printf '\n\n'

read -r -p "Release? [y/N] " ANSWER
[[ "$ANSWER" =~ ^[Yy]$ ]] || { echo "Release cancelled."; exit 0; }

release_committed=false
on_exit() {
  status=$?
  if [[ $status -ne 0 && "$release_committed" == false ]]; then
    printf '%s\n' "$CURRENT_VERSION" > "$VERSION_FILE"
  fi
  cleanup_artifacts
  exit "$status"
}
trap on_exit EXIT

# Build with the release version so BuildInfo contains the release number.
printf '%s\n' "$RELEASE_VERSION" > "$VERSION_FILE"

echo; echo "Running tests..."
"${TEST_COMMAND[@]}"

echo; echo "Building..."
"${BUILD_COMMAND[@]}"
[[ -f "$ARTIFACT" ]] || die "Build succeeded, but artifact was not found: $ARTIFACT"

cp "$ARTIFACT" "$RELEASE_ARTIFACT"
shasum -a 256 "$RELEASE_ARTIFACT" > "$CHECKSUM_FILE"

git add "$VERSION_FILE"
git commit -m "Release $RELEASE_VERSION"
release_committed=true
git tag -a "$TAG" -m "Release $RELEASE_VERSION"

echo; echo "Pushing release commit and tag..."
git push origin HEAD
git push origin "$TAG"

echo; echo "Creating GitHub Release..."
gh release create "$TAG" "$RELEASE_ARTIFACT" "$CHECKSUM_FILE" \
  --title "$RELEASE_VERSION" --generate-notes

printf '%s\n' "$NEXT_VERSION" > "$VERSION_FILE"
git add "$VERSION_FILE"
git commit -m "Prepare for $NEXT_VERSION"
git push origin HEAD

echo
echo "Released $RELEASE_VERSION successfully."
echo "Published artifact: $RELEASE_ARTIFACT"
echo "Development version: $NEXT_VERSION"
