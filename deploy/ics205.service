[Unit]
Description=ICS-205 Incident Radio Communications Plan Service
Documentation=https://github.com/dicklieber/ics205
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=ics205
Group=ics205

# Directory layout and state management
WorkingDirectory=/home/ics205

# Environment configuration
Environment="JAVA_HOME=/usr/lib/jvm/default-java"
Environment="JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC"
Environment="JAR_PATH=/home/ics205/app/ics205.jar"
EnvironmentFile=-/home/ics205/config/ics205.env

# Execution
# Keep these safety flags after JAVA_OPTS so older environment files cannot override them.
ExecStart=/usr/bin/java $JAVA_OPTS -Dhost=127.0.0.1 -Dauth.secureCookie=true -jar /home/ics205/app/ics205.jar

# Process management and restart policy
Restart=on-failure
RestartSec=5
TimeoutStopSec=30s
KillMode=mixed

# Resource limits
LimitNOFILE=65536

# Security hardening and sandboxing
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=false
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/ics205/data
ReadOnlyPaths=/home/ics205/app /home/ics205/config

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ics205

[Install]
WantedBy=multi-user.target
