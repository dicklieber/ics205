package build
import mill.*
import mill.contrib.buildinfo.BuildInfo
import mill.contrib.scoverage.ScoverageModule
import mill.scalalib.*

object core extends ScalaModule with BuildInfo with ScoverageModule:
  def scalaVersion = "3.7.4"
  def scoverageVersion = "2.3.0"
  def versionFile = Task.Source(moduleDir / os.up / "version.txt")
  def buildInfoPackageName = "ics205"
  def buildInfoMembers = Task {
    Seq(
      BuildInfo.Value("name", "ICS-205"),
      BuildInfo.Value("appName", "ICS-205"),
      BuildInfo.Value("productName", "ics205"),
      BuildInfo.Value("version", os.read(versionFile().path).trim),
      BuildInfo.Value("scalaVersion", scalaVersion()),
      BuildInfo.Value("millVersion", mill.constants.BuildInfo.millVersion)
    )
  }
  def mvnDeps = Seq(
    mvn"jakarta.inject:jakarta.inject-api:2.0.1",
    mvn"io.dropwizard.metrics5:metrics-core:5.0.4",
    mvn"io.dropwizard.metrics5:metrics-jvm:5.0.4",
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10",
    mvn"com.outr::scalapass:1.2.8",
    mvn"com.lihaoyi::os-lib:0.11.6",
    mvn"com.typesafe.scala-logging::scala-logging:3.9.5",
    mvn"org.apache.logging.log4j:log4j-slf4j2-impl:2.25.3",
    mvn"org.apache.logging.log4j:log4j-core:2.25.3",
    mvn"org.apache.commons:commons-lang3:3.17.0",
    mvn"com.github.andyglow::typesafe-config-scala:2.0.0"
  )
  object test extends ScalaTests with TestModule.Munit with ScoverageTests:
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.0")

object exporters extends ScalaModule with ScoverageModule:
  def scalaVersion = "3.7.4"
  def scoverageVersion = "2.3.0"
  def moduleDeps = Seq(core)
  def mvnDeps = Seq(
    mvn"org.apache.commons:commons-csv:1.14.0",
    mvn"org.apache.pdfbox:pdfbox:3.0.8",
    mvn"io.github.classgraph:classgraph:4.8.195"
  )
  object test extends ScalaTests with TestModule.Munit with ScoverageTests:
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.0")

object web extends ScalaModule with ScoverageModule:
  def scalaVersion = "3.7.4"
  def scoverageVersion = "2.3.0"
  def moduleDeps = Seq(core, exporters)
  def mvnDeps = Seq(
    mvn"net.codingwell::scala-guice:7.0.0",
    mvn"com.google.inject:guice:7.0.0",
    mvn"com.google.inject.extensions:guice-assistedinject:7.0.0",
    mvn"io.github.classgraph:classgraph:4.8.195",
    mvn"com.softwaremill.sttp.tapir::tapir-http4s-server:1.11.44",
    mvn"com.softwaremill.sttp.tapir::tapir-json-circe:1.11.44",
    mvn"org.http4s::http4s-ember-server:0.23.30",
    mvn"com.fasterxml.jackson.core:jackson-databind:2.20.1",
    mvn"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:2.20.1",
    mvn"com.lihaoyi::scalatags:0.13.1"
  )
  def mainClass = Some("ics205.web.Main")
  object test extends ScalaTests with TestModule.Munit with ScoverageTests:
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.0")
