//| mvnDeps: ["com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION"]
package build
import mill.*
import mill.contrib.buildinfo.BuildInfo
import mill.scalalib.*

object core extends ScalaModule:
  def scalaVersion = "3.7.4"
  def mvnDeps = Seq(
    mvn"io.circe::circe-core:0.14.10",
    mvn"io.circe::circe-generic:0.14.10",
    mvn"io.circe::circe-parser:0.14.10"
  )
  object test extends ScalaTests with TestModule.Munit:
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.0")

object exporters extends ScalaModule:
  def scalaVersion = "3.7.4"
  def moduleDeps = Seq(core)
  object test extends ScalaTests with TestModule.Munit:
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.0")

object web extends ScalaModule with BuildInfo:
  def scalaVersion = "3.7.4"
  def versionFile = Task.Source(moduleDir / os.up / "version.txt")
  def buildInfoPackageName = "ics205.web"
  def buildInfoMembers = Task {
    Seq(
      BuildInfo.Value("name", "ICS-205"),
      BuildInfo.Value("version", os.read(versionFile().path).trim),
      BuildInfo.Value("scalaVersion", scalaVersion()),
      BuildInfo.Value("millVersion", mill.constants.BuildInfo.millVersion)
    )
  }
  def moduleDeps = Seq(core, exporters)
  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.tapir::tapir-http4s-server:1.11.44",
    mvn"org.http4s::http4s-ember-server:0.23.30",
    mvn"com.typesafe.scala-logging::scala-logging:3.9.5",
    mvn"org.apache.logging.log4j:log4j-slf4j2-impl:2.25.3",
    mvn"org.apache.logging.log4j:log4j-core:2.25.3",
    mvn"com.fasterxml.jackson.core:jackson-databind:2.20.1",
    mvn"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:2.20.1",
    mvn"com.lihaoyi::scalatags:0.13.1"
  )
  def mainClass = Some("ics205.web.Main")
